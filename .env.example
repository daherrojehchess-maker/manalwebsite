# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API / API Keys
# Use the Project URL and the publishable key (or legacy "anon" key).
# Never put the service_role / secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
